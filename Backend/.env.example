# Database Configuration
# PostgreSQL with PostGIS is REQUIRED (no in-memory fallback)
DATABASE_URL="postgresql://user:password@localhost:5432/lewahub"

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Configuration
# REQUIRED: Must be at least 32 characters long. The server will refuse to start otherwise.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# AI Configuration (optional - falls back to keyword search if not set)
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-api-key
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Redis Configuration (optional - caching is skipped if not set)
# REDIS_URL=redis://localhost:6379