# Database Configuration
# PostgreSQL with PostGIS is REQUIRED (no in-memory fallback)
DATABASE_URL="postgresql://user:password@localhost:5432/lewahub"

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend Configuration
# In production this MUST be the real frontend origin (e.g. https://lewahub.example.com)
FRONTEND_URL=http://localhost:5173

# CORS Configuration
# Comma-separated list of allowed browser origins. In production the localhost
# defaults are NOT included automatically - only FRONTEND_URL and anything listed
# here are permitted. Leave unset in development to use the localhost defaults.
# CORS_ORIGINS=https://lewahub.example.com

# Rate Limiting
# Comma-separated IPs that bypass rate limits (e.g. office NAT egress).
# RATE_LIMIT_ALLOWLIST=203.0.113.10,203.0.113.20

# Admin session cookie
# Session length is fixed at 24 hours. The cookie is httpOnly; `secure` and
# `sameSite` are derived from NODE_ENV (secure + SameSite=None in production,
# Lax on localhost development).

# Server timeouts (ms) - guards against slow/idle connections
# SERVER_TIMEOUT_MS=30000
# SERVER_HEADERS_TIMEOUT_MS=10000

# AI Configuration (optional - search falls back to keyword search if not set)
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-api-key
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Redis Configuration (optional - caching is skipped if not set)
# REDIS_URL=redis://localhost:6379
