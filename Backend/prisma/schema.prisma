// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id              String   @id @default(cuid())
  name            String
  category        String            // "PrimaryNursery" | "Secondary" | "University"
  offersHighSchool Boolean @default(false)  // only meaningful when category = "Secondary"
  secondaryStreams String[] @default([])   // e.g. ["General"], ["General", "Technical"] — only meaningful when category = "Secondary"
  ageRange        String?            // e.g. "3-6 years" — PrimaryNursery
  studentTeacherRatio String?        // e.g. "1:8" — PrimaryNursery
  curriculum      String?            // "Anglophone" | "Francophone" | "Bilingual"
  annualFee       Int?               // in local currency
  classesOffered  String[] @default([])  // e.g. ["Form 1", "Form 2"] — Secondary
  programType     String?            // "Day" | "Boarding" — Secondary
  highSchoolPrograms String? @db.Text  // e.g. "Sciences, Literature" — Secondary with high school
  description     String   @db.Text
  region          String
  city            String
  address         String
  latitude        Float
  longitude       Float
  website         String?
  imageUrl        String?
  contactEmail    String?
  contactPhone    String?
  language        String?  // "Anglophone" | "Francophone" | "Bilingual"
  ownership       String?  // "Public" | "Private" | "Mission"
  boarding        String?  // "Day" | "Boarding" | "Both"
  verified        Boolean  @default(false)
  aiSummary       String?  @db.Text
  anonymousViews  Int      @default(0)
  programs        Program[]
  draftSummaries  SchoolDraftSummary[]
  images          SchoolImage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([region])
  @@index([city])
  @@index([category])
  @@index([verified])
}

model Program {
  id              String   @id @default(cuid())
  name            String
  level           String   // Bachelor, Master, Doctorate
  duration        String   // e.g., "3 years"
  tuition         Int?     // in local currency
  description     String?  @db.Text
  school          School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId])
}

model SchoolImage {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  url      String
  caption  String?
  order    Int    @default(0)

  @@index([schoolId])
}

model SchoolDraftSummary {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  status    String   @default("DRAFT") // DRAFT | APPROVED | REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([status])
}

model VerificationToken {
  id        String   @id @default(cuid())
  hash      String   @unique // SHA256 hash of token (never store raw token)
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
